# Copy to .env (never commit .env). Replace every value; generate the JWT secret with: openssl rand -base64 48
POSTGRES_DB=altbank
DATABASE_URL=jdbc:postgresql://localhost:5432/altbank
DATABASE_USERNAME=altbank
DATABASE_PASSWORD=change-me-to-a-long-random-password
ALT_JWT_SECRET=change-me-generate-with-openssl-rand-base64-48-minimum-32-bytes
# dev = demo seed data + Swagger UI + readable logs; prod = no seed data, no Swagger, JSON logs
SPRING_PROFILES_ACTIVE=dev
ALT_WORKER_POOL_SIZE=10
HIKARI_MAX_POOL_SIZE=20
# Comma-separated list; empty = same-origin only
ALT_CORS_ALLOWED_ORIGINS=
